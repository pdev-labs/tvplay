# tv-auto - background fallback: download a URL, serve it, hand it to the TV.
# Started by tvplay when TV_FALLBACK=auto. All output goes to ~/tvplay.log.
set -u

# shellcheck source=tvlib
. "$HOME/bin/tvlib"

url="${1:-}"
[ -n "$url" ] || { tv_err "usage: tv-auto <url>"; exit 2; }

exec >>"$TVLOG" 2>&1
echo "$(date '+%F %T') auto: downloading $url"

if tv-fetch "$url"; then
  ip=$(tv_local_ip)
  TV_QUIET=1 TV_FALLBACK=off tvplay "http://$ip:${TV_SERVE_PORT:-8080}/now"
else
  echo "$(date '+%F %T') auto: download failed"
  exit 1
fi
