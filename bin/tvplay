#!/data/data/com.termux/files/usr/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Copyright (C) 2026 pdev-labs
# tvplay - send a stream URL to VLC on the Android TV over ADB.
#
#   tvplay "https://example.com/movie.mkv"
#
# Environment (~/.tvrc): TV_IP, TV_PORT, TV_WAIT, TV_FALLBACK=manual|auto|off
set -u

# shellcheck source=tvlib
. "$HOME/bin/tvlib"

url="${1:-}"
[ -n "$url" ] || { tv_say "usage: tvplay <url>"; exit 2; }
case "$url" in
  http://*|https://*|rtsp://*|rtmp://*) ;;
  *) tv_say "not a stream URL: $url"; exit 2 ;;
esac
case "$url" in
  *"'"*) tv_say "URL contains a single quote, refusing"; exit 2 ;;
esac

launch() {
  local out
  out=$(adb -s "$DEV" shell \
    "am start -n org.videolan.vlc/.gui.MainActivity -a android.intent.action.VIEW -d '$1' -t 'video/*'" 2>&1)
  case "$out" in
    *Error*|*Exception*)
      out=$(adb -s "$DEV" shell \
        "am start -a android.intent.action.VIEW -d '$1' -t 'video/*'" 2>&1)
      ;;
  esac
  tv_log "am: $out"
}

main() {
  local i=0

  if [ -z "$TV_IP" ]; then
    tv_say "TV_IP not set in ~/.tvrc"
    tv_phone_play "$url"
  fi

  if ! tv_adb_up; then
    tv_say "cannot reach $DEV"
    if tv_discover && tv_adb_up; then
      :
    else
      tv_log "unreachable: $DEV"
      tv_phone_play "$url"
    fi
  fi

  launch "$url"
  while [ "$i" -lt "${TV_WAIT:-20}" ]; do
    sleep 1
    i=$((i + 1))
    if tv_playing; then
      tv_log "playing on TV after ${i}s: $url"
      tv_say "playing on TV"
      return 0
    fi
  done

  tv_log "no playback after ${TV_WAIT:-20}s: $url"
  tv_say "TV did not start playback within ${TV_WAIT:-20}s"

  case "${TV_FALLBACK:-manual}" in
    auto)
      tv_say "downloading and serving locally"
      if tv-fetch "$url" >/dev/null; then
        local ip
        ip=$(tv_local_ip)
        TV_FALLBACK=off tvplay "http://$ip:${TV_SERVE_PORT:-8080}/now"
      else
        tv_say "download failed too"
        return 1
      fi
      ;;
    off) return 1 ;;
    *) tv_say "download it with: tv-fetch '$url'" ;;
  esac
}

main "$@"
